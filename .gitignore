# Dependencies & build
node_modules
.next
out
dist
*.local

# Lockfiles: pnpm-lock.yaml is tracked on purpose. Vercel infers the package
# manager from the lockfile, so an ignored one makes deploys run `npm install`,
# which then aborts on the devEngines.packageManager pin in package.json.
package-lock.json
yarn.lock
bun.lock
bun.lockb

# TypeScript incremental build
*.tsbuildinfo

# Next.js auto-generated
types-env.d.ts
next-env.d.ts

